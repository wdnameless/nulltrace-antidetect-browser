node_modules/
dist/
data/
release/
release-pub*/
transcript*.txt
*.log
.DS_Store
Thumbs.db

# Compiled SDK artifacts inside src (tsc build output belongs in dist/)
packages/sdk-node/src/*.js
packages/sdk-node/src/*.js.map
packages/sdk-node/src/*.d.ts
packages/sdk-node/src/*.d.ts.map

# Legacy opencode harness dirs (codebase-index MCP data; moved to ~/.omp host mode 'pi').
#
# Anchored at the repository root deliberately. A bare `profiles/` also matches
# `src/main/profiles/`, which is SOURCE: a new file there would be silently ignored — the
# tracked files survive only because git keeps what it already has — and the omission would
# surface later as a broken build or a lost change.
/.opencode/
/.codebase-index/
/profiles/

# Rust build output — never commit compiled artefacts.
target/
**/target/

# Tauri generated schemas/capabilities — regenerated on build.
src-tauri/gen/
src-tauri/target/

# Vendored Node runtime for the sidecar (~70 MB). Fetched and checksum-verified by
# `npm run vendor:node`, so committing it would add tens of megabytes of binary to
# every clone for something the build reproduces.
src-tauri/binaries/

# Updater release metadata (latest.json + .sig) produced by scripts/build-updater-manifest.mjs.
# Generated per release and signed with a CI-only key, so it never belongs in the tree.
dist-release/

# Tauri signing keys — the PRIVATE key can publish updates on the app's behalf.
# `tauri signer generate -w ~/.tauri/...` writes into the CURRENT DIRECTORY when the shell
# does not expand `~`, which once put the key inside this repo (a public one). Guard the
# literal `~` folder, the usual `.tauri` locations, and the key formats themselves.
~/
.tauri/
**/.tauri/
*.key
*.key.pub

# QA screenshots captured while verifying UI work. They are throwaway evidence, unreferenced
# by any doc or source, and 16 of them accumulated in the repo root. Scoped to the root so a
# future `assets/` directory with intentional images is unaffected.
/*.png

# Architecture map output (generated by tools/archmap.mjs, not source)
.archmap/

# A live application data directory that happened to be created in the repo root. It holds a real
# `antidetect.db`, profile directories, Chromium downloads and backups — the operator's actual data,
# which must never be committed and must never be published in a release artefact.
NULLTRACE/

# Local stealth benchmark scratch: ~145 MB of probes and captured JSON, regenerated on demand.
.stealth-bench/

# Workflow dashboard runtime files (regenerated per session, not source).
.workflow/dashboards/
.workflow/dashboard.html
.workflow/dashboard.json
