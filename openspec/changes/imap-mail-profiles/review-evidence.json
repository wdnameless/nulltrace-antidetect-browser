    "report": "{\n  \"findings\": [\n    {\n      \"title\": \"Restrict email:send scope to send tool only\",\n      \"body\": \"isAuthorized grants any email.* gated tool when the caller presents email:send, so isAuthorized('email.accounts.delete','email:send') returns true and a send-only token can delete an account and its drafts/outbox/cache via deleteAccount. The manifest describes delete as requiring admin/profile:write_danger, so send scope must not imply delete.\",\n      \"priority\": 1,\n      \"confidence\": 0.9,\n      \"file_path\": \"mcp/src/auth.ts\",\n      \"line_start\": 336,\n      \"line_end\": 345\n    },\n    {\n      \"title\": \"Scope draft update and readback by account\",\n      \"body\": \"saveDraft looks up the draft by id alone, then runs UPDATE WHERE id AND account_id, then reads back by id alone. Reusing an id owned by another account makes the UPDATE affect zero rows and returns the other account's row unchanged, so the caller sees a successful save of stale foreign data while nothing was written.\",\n      \"priority\": 1,\n      \"confidence\": 0.85,\n      \"file_path\": \"src/main/email/manager.ts\",\n      \"line_start\": 210,\n      \"line_end\": 219\n    },\n    {\n      \"title\": \"Scope flags cache update by folder\",\n      \"body\": \"setMessageFlags selects and updates email_messages_cache by account_id and uid only, but UIDs are folder-scoped and the cache key is (account_id, folder, uid). With the same UID present in INBOX and Sent, flagging one folder reads and rewrites the other folder's row, corrupting cached seen/flagged state.\",\n      \"priority\": 2,\n      \"confidence\": 0.85,\n      \"file_path\": \"src/main/email/manager.ts\",\n      \"line_start\": 340,\n      \"line_end\": 349\n    }\n  ],\n  \"overall_correctness\": \"incorrect\",\n  \"overall_explanation\": \"Patch adds real mail-profile value but ships a send-scope privilege overreach plus two account/folder scoping defects that silently corrupt or leak drafts and flags. Lean already.\",\n  \"overall_confidence_score\": 0.85\n}",
