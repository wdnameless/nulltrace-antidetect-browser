"// Flow: Browser Flow (id: browser-flow, version: undefined)
// Deterministically compiled by Afina FlowCompiler
return await (async function runFlow() {
  const __vars = {};
  const __results = {};
  let __currentNodeId = "n-nav";

  function __logSpanStart(nodeId, type) {
    app.log('[FLOW_SPAN_START] ' + nodeId + ' ' + type + ' ' + Date.now());
  }

  function __logSpanEnd(nodeId, startMs) {
    const duration = Date.now() - startMs;
    app.log('[FLOW_SPAN_END] ' + nodeId + ' ' + duration);
  }

  function __logNodeError(nodeId, err) {
    const msg = (err && err.message) || String(err);
    app.log('[FLOW_NODE_ERROR] ' + nodeId + ' ' + msg);
  }

  async function __executeNode_n_click() {
    const __t0 = Date.now();
    __logSpanStart("n-click", "click");
    try {
      // Action: click
      const __selector = "#btn";
      app.log('Clicking selector: ' + __selector);
      if (typeof app.browser?.click === 'function') {
        await app.browser.click(__selector, { waitForSelector: false, timeout: 10000 });
      } else {
        app.log('Simulated click on ' + __selector);
      }
      return "n-type";
      __logSpanEnd("n-click", __t0);
    } catch (err) {
      __logNodeError("n-click", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-click" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-click", originalError: err });
    }
  }

  async function __executeNode_n_nav() {
    const __t0 = Date.now();
    __logSpanStart("n-nav", "navigate");
    try {
      // Action: navigate
      const __targetUrl = "https://example.com";
      app.log('Navigating to ' + __targetUrl);
      if (typeof app.browser?.navigate === 'function') {
        await app.browser.navigate(__targetUrl, { timeout: 30000 });
      } else {
        // HTTP fallback / simulated fetch
        await app.http.fetch(__targetUrl, { method: 'GET' });
      }
      return "n-click";
      __logSpanEnd("n-nav", __t0);
    } catch (err) {
      __logNodeError("n-nav", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-nav" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-nav", originalError: err });
    }
  }

  async function __executeNode_n_type() {
    const __t0 = Date.now();
    __logSpanStart("n-type", "type");
    try {
      // Action: type
      const __selector = "#input";
      const __text = "hello";
      app.log('Typing into selector ' + __selector + ' (length: ' + __text.length + ')');
      if (typeof app.browser?.type === 'function') {
        await app.browser.type(__selector, __text, { clear: false, delay: 0 });
      } else {
        app.log('Simulated typing into ' + __selector);
      }
      return "n-wait";
      __logSpanEnd("n-type", __t0);
    } catch (err) {
      __logNodeError("n-type", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-type" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-type", originalError: err });
    }
  }

  async function __executeNode_n_wait() {
    const __t0 = Date.now();
    __logSpanStart("n-wait", "wait");
    try {
      // Action: wait
      app.log('Waiting for ' + 1000 + 'ms');
      await new Promise((resolve) => setTimeout(resolve, 1000));
      return null;
      __logSpanEnd("n-wait", __t0);
    } catch (err) {
      __logNodeError("n-wait", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-wait" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-wait", originalError: err });
    }
  }

  while (__currentNodeId) {
    const nextNodeId = await (async () => {
      switch (__currentNodeId) {
        case "n-click":
          return await __executeNode_n_click();
        case "n-nav":
          return await __executeNode_n_nav();
        case "n-type":
          return await __executeNode_n_type();
        case "n-wait":
          return await __executeNode_n_wait();
        default:
          throw new Error('Unknown flow node ID: ' + __currentNodeId);
      }
    })();
    __currentNodeId = nextNodeId;
  }

  return {
    status: 'completed',
    variables: __vars,
    results: __results,
  };
})();"
