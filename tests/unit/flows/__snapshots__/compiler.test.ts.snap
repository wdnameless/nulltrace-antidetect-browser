"// Flow: Complex Flow (id: complex-flow, version: undefined)
// Deterministically compiled by Afina FlowCompiler
return await (async function runFlow() {
  const __vars = {
  "count": 0
};
  const __results = {};
  let __currentNodeId = "n-cond";

  function __logSpanStart(nodeId, type) {
    app.log('[FLOW_SPAN_START] ' + nodeId + ' ' + type + ' ' + Date.now());
  }

  function __logSpanEnd(nodeId, startMs) {
    const duration = Date.now() - startMs;
    app.log('[FLOW_SPAN_END] ' + nodeId + ' ' + duration);
  }

  function __logNodeError(nodeId, err) {
    const msg = (err && err.message) || String(err);
    app.log('[FLOW_NODE_ERROR] ' + nodeId + ' ' + msg);
  }

  async function __executeNode_n_cond() {
    const __t0 = Date.now();
    __logSpanStart("n-cond", "condition");
    try {
      // Action: condition
      const __test = (() => {
        const vars = __vars;
        return Boolean(vars.count > 0);
      })();
      app.log('Condition evaluated: ' + __test);
      if (__test) {
        return "n-loop";
      } else {
        return "n-extract";
      }
      __logSpanEnd("n-cond", __t0);
    } catch (err) {
      __logNodeError("n-cond", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-cond" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-cond", originalError: err });
    }
  }

  async function __executeNode_n_eval() {
    const __t0 = Date.now();
    __logSpanStart("n-eval", "eval");
    try {
      // Action: eval
      const __evalResult = await (async () => {
        const vars = __vars;
        vars.count += 1;
      })();
      app.log('Evaluated code snippet for node ' + "n-eval");
      return null;
      __logSpanEnd("n-eval", __t0);
    } catch (err) {
      __logNodeError("n-eval", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-eval" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-eval", originalError: err });
    }
  }

  async function __executeNode_n_extract() {
    const __t0 = Date.now();
    __logSpanStart("n-extract", "extract");
    try {
      // Action: extract
      const __selector = "h1";
      const __attr = "";
      let __extracted = null;
      if (typeof app.browser?.extract === 'function') {
        __extracted = await app.browser.extract(__selector, { attribute: __attr, multiple: false });
      } else {
        __extracted = 'simulated_extracted_value';
      }
      __vars["title"] = __extracted;
      app.log('Extracted value for ' + "title" + ': ' + JSON.stringify(__extracted));
      return "n-mod";
      __logSpanEnd("n-extract", __t0);
    } catch (err) {
      __logNodeError("n-extract", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-extract" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-extract", originalError: err });
    }
  }

  async function __executeNode_n_loop() {
    const __t0 = Date.now();
    __logSpanStart("n-loop", "loop");
    try {
      // Action: loop
      if (!__results["n-loop"]) {
        __results["n-loop"] = { iteration: 0 };
      }
      const __loopState = __results["n-loop"];
      const __maxIter = 5;
      let __continueLoop = false;
      if (__loopState.iteration < 3 && __loopState.iteration < __maxIter) {
        __continueLoop = true;
        __loopState.iteration++;
      }
      if (__continueLoop) {
        app.log('Loop iteration ' + __loopState.iteration + ' for node ' + "n-loop");
        return "n-shot";
      } else {
        app.log('Loop complete for node ' + "n-loop");
        return "n-eval";
      }
      __logSpanEnd("n-loop", __t0);
    } catch (err) {
      __logNodeError("n-loop", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-loop" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-loop", originalError: err });
    }
  }

  async function __executeNode_n_mod() {
    const __t0 = Date.now();
    __logSpanStart("n-mod", "module");
    try {
      // Action: module
      const __moduleId = "auth-mod";
      const __args = {};
      app.log('Calling script module ' + __moduleId);
      const __moduleResult = await app.callModule(__moduleId, __args);
      return null;
      __logSpanEnd("n-mod", __t0);
    } catch (err) {
      __logNodeError("n-mod", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-mod" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-mod", originalError: err });
    }
  }

  async function __executeNode_n_shot() {
    const __t0 = Date.now();
    __logSpanStart("n-shot", "screenshot");
    try {
      // Action: screenshot
      let __shot = null;
      if (typeof app.browser?.screenshot === 'function') {
        __shot = await app.browser.screenshot({ fullPage: true, selector: "" });
      } else {
        __shot = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==';
      }
      app.log('Captured screenshot' + ("Shot" ? ' (' + "Shot" + ')' : ''));
      return null;
      __logSpanEnd("n-shot", __t0);
    } catch (err) {
      __logNodeError("n-shot", err);
      throw Object.assign(new Error('[FLOW_FAILED_AT_NODE:' + "n-shot" + '] ' + ((err && err.message) || String(err))), { nodeId: "n-shot", originalError: err });
    }
  }

  while (__currentNodeId) {
    const nextNodeId = await (async () => {
      switch (__currentNodeId) {
        case "n-cond":
          return await __executeNode_n_cond();
        case "n-eval":
          return await __executeNode_n_eval();
        case "n-extract":
          return await __executeNode_n_extract();
        case "n-loop":
          return await __executeNode_n_loop();
        case "n-mod":
          return await __executeNode_n_mod();
        case "n-shot":
          return await __executeNode_n_shot();
        default:
          throw new Error('Unknown flow node ID: ' + __currentNodeId);
      }
    })();
    __currentNodeId = nextNodeId;
  }

  return {
    status: 'completed',
    variables: __vars,
    results: __results,
  };
})();"
`;

