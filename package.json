{
  "name": "antidetect-browser",
  "version": "0.6.57",
  "private": true,
  "description": "NullTrace — zero footprint, infinite scale. Personal antidetect browser with an AdsPower-compatible Local API.",
  "workspaces": [
    "packages/*",
    "mcp"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "pretypecheck": "npm run build:sdk",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "pretest": "npm run build:sdk",
    "test": "vitest run",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p src/renderer/tsconfig.json --noEmit",
    "build:mcp": "tsc -p mcp/tsconfig.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "prebuild": "npm run build:sdk",
    "build": "npm run build:main && npm run build:renderer && npm run build:mcp",
    "copy:prod-deps": "node scripts/copy-prod-deps.mjs",
    "build:sdk": "npm run build --workspace @antidetect/sdk",
    "icon:generate": "node scripts/generate-app-icon.mjs",
    "vite:dev": "vite --config src/renderer/vite.config.ts",
    "dev": "npm run build && npm run vendor:node && tauri dev",
    "service": "tsx src/main/index.ts",
    "baseline:prepare-clone": "tsx scripts/create-isolated-clone.ts",
    "baseline:legacy-api": "tsx scripts/baseline-legacy-api.ts",
    "baseline:chromium": "tsx scripts/baseline-chromium.ts",
    "check:webrtc": "tsx scripts/check-webrtc.ts",
    "check:network-capture": "tsx scripts/check-network-capture.ts",
    "check:repo-release-hygiene": "tsx scripts/check-repo-release-hygiene.ts",
    "check:privacy-artifacts": "tsx scripts/check-privacy-artifacts.ts",
    "check:artifact-hygiene": "tsx scripts/json-artifact-hygiene.ts",
    "claims:verify": "tsx scripts/claims-verify.ts",
    "check:camoufox-audit": "tsx scripts/camoufox-audit.ts",
    "corpus:generate": "tsx scripts/generate-legacy-corpus.ts",
    "corpus:verify": "tsx scripts/verify-legacy-corpus.ts",
    "contract:replay": "tsx scripts/contract-replay.ts",
    "check:docs-claims": "tsx scripts/check-docs-claims.ts",
    "check:package-hygiene": "tsx scripts/check-package-hygiene.ts",
    "check:camoufox-e2e": "tsx scripts/camoufox-e2e-check.ts",
    "sbom:generate": "tsx scripts/generate-sbom.ts",
    "sbom:verify": "tsx scripts/generate-sbom.ts --verify",
    "manifest:sign": "tsx scripts/sign-manifest.ts",
    "manifest:verify": "tsx scripts/verify-manifest.ts",
    "authenticode:verify": "tsx scripts/verify-authenticode.ts",
    "install-chromium": "node scripts/install-chromium.mjs",
    "ensure-kernel": "node scripts/ensure-kernel.mjs",
    "ensure-chromedriver": "node scripts/ensure-chromedriver.mjs",
    "vendor:node": "node scripts/vendor-node.mjs",
    "tauri:dev": "npm run build && npm run vendor:node && tauri dev",
    "tauri:build": "npm run build && npm run copy:prod-deps && npm run vendor:node && tauri build && node scripts/build-portable.mjs",
    "tauri:build:portable": "node scripts/build-portable.mjs",
    "test:sync-server": "vitest run packages/sync-server",
    "openapi:check": "vitest run tests/unit/sdk/conformance.test.ts"
  },
  "dependencies": {
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "http-proxy-agent": "^5.0.0",
    "node-fetch": "^2.7.0",
    "playwright": "^1.60.0",
    "puppeteer-core": "^25.9.0",
    "socks-proxy-agent": "^6.2.1",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "js-yaml": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  }
}
